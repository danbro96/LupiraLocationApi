<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal helpers (Geo, PartitionManager.Bounds) for unit testing. -->
    <InternalsVisibleTo Include="LupiraLocationApi.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bounded context + data: Domain (identity, devices, location intelligence), Application (services +
         OpResult + the raw-Npgsql telemetry ingest/query path), Dtos, Mappers. Marten is the document store on the
         `location` schema; the `telemetry` schema is raw partitioned tables written via Npgsql (which flows in
         transitively from Marten). No ASP.NET dependency — that lives in the host. -->
    <PackageReference Include="Lupira.Auth.DeviceKeys" Version="1.0.0" />
    <PackageReference Include="Lupira.Identity.Marten" Version="0.1.0" />
    <PackageReference Include="Lupira.Postgres.Health" Version="0.1.0" />
    <PackageReference Include="Lupira.Postgres.Partitions" Version="1.0.0" />
    <PackageReference Include="Lupira.Primitives" Version="1.0.0" />
    <PackageReference Include="Lupira.Results" Version="1.0.0" />
    <PackageReference Include="Marten" Version="9.40.0" />
  </ItemGroup>

</Project>
